# Copia este archivo a .env.local y pon tu clave. Nunca se versiona.
# La clave se saca del panel de Resend y se pone tambien en Vercel.
RESEND_API_KEY=

# Copia de cada mensaje en la hoja de Google «Contactos del portafolio».
# Salen del Apps Script de la hoja (scripts/contactos-hoja.gs): la URL de la
# aplicacion web y la clave que `configurar` escribe en el registro. Opcionales:
# sin ellas el correo sale igual y no se guarda fila.
CONTACTOS_HOJA_URL=
CONTACTOS_HOJA_CLAVE=
